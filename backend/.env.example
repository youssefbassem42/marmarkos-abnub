APP_NAME=Marmarkos ABNUB API
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Google Identity Services OAuth client ID (Sign in with Google)
GOOGLE_CLIENT_ID=

CORS_ORIGINS=http://localhost:5173

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Marmarkos ABNUB

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -- Attendance (Phase 2) ----------------------------------------------------
# IANA timezone every attendance date/time is computed in.
PLATFORM_TIMEZONE=Africa/Cairo
# Local HH:MM the weekly meeting starts; scans later than start + grace
# are recorded as LATE.
MEETING_START_TIME=18:00
# Minutes after MEETING_START_TIME still counted as on-time.
MEETING_LATE_GRACE_MINUTES=15
# Local HH:MM on the meeting day after which the absent list is final.
MEETING_ABSENCE_CUTOFF_TIME=21:00
# History pagination defaults for GET /api/v1/attendance.
ATTENDANCE_HISTORY_PAGE_SIZE=20
ATTENDANCE_HISTORY_MAX_PAGE_SIZE=100
