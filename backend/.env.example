APP_NAME=Marmarkos ABNUB API
APP_ENV=development
DEBUG=true

# Diagnostics only: adds the exception type/message to 500 responses and an
# X-Error-Type header. Never leave this on in production.
EXPOSE_ERROR_DETAILS=false

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Google Identity Services OAuth client ID (Sign in with Google)
GOOGLE_CLIENT_ID=
# Google OAuth client secret paired with GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_SECRET=

# Public origin of the web app; used to build links inside emails and
# notification CTAs.
FRONTEND_URL=http://localhost:5173

CORS_ORIGINS=http://localhost:5173

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Seconds allowed for one sendMessage call; attempts retried on timeout/5xx.
TELEGRAM_TIMEOUT_SECONDS=15
# Inline delivery attempts within a single request (4xx never retries).
TELEGRAM_SEND_ATTEMPTS=2

# Mail provider: auto (detect from credentials) | brevo | gmail | console
MAIL_PROVIDER=auto
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Marmarkos ABNUB

# Gmail SMTP transport — the mailbox the emails are sent from.
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# From: display name used by ALL mail transports (Brevo and Gmail).
# When empty, falls back to BREVO_SENDER_NAME for backwards compatibility.
MAIL_SENDER_NAME=

# Lifespan of single-use account links (verification / password reset).
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -- Attendance (Phase 2) ----------------------------------------------------
# IANA timezone every attendance date/time is computed in.
PLATFORM_TIMEZONE=Africa/Cairo
# Local HH:MM the weekly meeting starts; scans later than start + grace
# are recorded as LATE.
MEETING_START_TIME=18:00
# Minutes after MEETING_START_TIME still counted as on-time.
MEETING_LATE_GRACE_MINUTES=15
# Local HH:MM on the meeting day after which the absent list is final.
MEETING_ABSENCE_CUTOFF_TIME=21:00
# History pagination defaults for GET /api/v1/attendance.
ATTENDANCE_HISTORY_PAGE_SIZE=20
ATTENDANCE_HISTORY_MAX_PAGE_SIZE=100
# Dedicated pepper for attendance PIN hashes. Generate with:
#   openssl rand -hex 32
# Keeping this separate from JWT_SECRET means rotating tokens does NOT
# invalidate members' attendance PINs. When empty, falls back to a
# JWT_SECRET derivative (backwards compat) but logs a warning.
ATTENDANCE_PIN_PEPPER=

# -- Notifications & anonymous messages (Phase 4) ----------------------------
# Feed pagination defaults for GET /api/v1/notifications.
NOTIFICATIONS_PAGE_SIZE=20
NOTIFICATIONS_MAX_PAGE_SIZE=100
# Simultaneous inline sends during a broadcast email fan-out (BR-8).
# Gmail SMTP will throttle bulk sends; prefer Brevo where broadcasts run.
NOTIFICATION_EMAIL_CONCURRENCY=10
# Anonymous message bounds (BR-16): message length after trimming.
ANONYMOUS_MESSAGE_MIN_LENGTH=10
ANONYMOUS_MESSAGE_MAX_LENGTH=1000
# Rate limits (BR-15, D-22): in-memory sliding windows, per instance,
# reset on restart. 5/hour per IP and 10/day per authenticated user.
ANONYMOUS_MESSAGE_RATE_LIMIT_PER_IP=5
ANONYMOUS_MESSAGE_RATE_LIMIT_PER_USER=10
# Read the first X-Forwarded-For hop as the client IP (reverse proxies only).
TRUST_PROXY_HEADERS=false

# -- Bible verses, quizzes & points (Phase 5) ---------------------------------
# Shared secret for POST /api/v1/internal/scheduler/tick (D-3). When unset
# the tick endpoint answers 503 scheduler_disabled unless called with an
# ADMIN bearer token. Generate locally with: openssl rand -hex 32
CRON_SECRET=
# How many due schedules / outbox events one tick claims at most (BR-10).
SCHEDULER_TICK_MAX_BATCH=50
# Verse-open dedupe window in seconds (D-16): refreshes within the window
# do not inflate "Total Opens".
VERSE_OPEN_DEDUPE_SECONDS=300
# Member feed pagination defaults for GET /api/v1/bible-verses/published.
BIBLE_VERSES_PAGE_SIZE=12
BIBLE_VERSES_MAX_PAGE_SIZE=50
# Quiz timer bounds in seconds; the UI offers 1/2/5/10/15/30 min + custom (BR-17).
QUIZ_MIN_DURATION_SECONDS=30
QUIZ_MAX_DURATION_SECONDS=7200
# Authoring limits: questions per quiz and options per question (BR-19/BR-20).
QUIZ_MAX_QUESTIONS=50
QUIZ_MAX_OPTIONS_PER_QUESTION=6
# Network-latency tolerance around expiresAt before an attempt counts as
# expired (BR-26/BR-27).
QUIZ_ATTEMPT_GRACE_SECONDS=5
# Analytics table pagination defaults.
QUIZ_ANALYTICS_PAGE_SIZE=10
QUIZ_ANALYTICS_MAX_PAGE_SIZE=100
# Maximum months returned by GET /users/me/points/monthly (?months=).
POINTS_HISTORY_MAX_MONTHS=24
# Hard row cap for every analytics CSV export (BR-40, D-15).
ANALYTICS_EXPORT_MAX_ROWS=5000
