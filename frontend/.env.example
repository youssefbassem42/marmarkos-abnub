# Same-origin API path. The browser must never talk to a second domain, or
# the HttpOnly refresh cookie (SameSite=Lax, path=/api/v1/auth) is dropped and
# sessions die after 30 minutes with no way to recover.
#   - production: served by the rewrite in frontend/vercel.json
#   - local dev:  served by the proxy in vite.config.ts
# Point VITE_DEV_API_TARGET at the backend if it is not on localhost:8000.
VITE_API_BASE_URL=marmarkos-abnub-ny1l.vercel.app/api/v1

# Google Identity Services OAuth client ID (Sign in with Google).
# Leave empty to render the Google button as a disabled placeholder.
VITE_GOOGLE_CLIENT_ID=
